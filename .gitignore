# ─────────────────────────────────────────────────────────────────────────────
# KCP — React Native + Firebase .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── React Native ──────────────────────────────────────────────────────────────
.expo/
.expo-shared/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ── Android ───────────────────────────────────────────────────────────────────
android/app/build/
android/app/.cxx/
android/build/
android/.gradle/
android/.kotlin/
android/local.properties

# 🔐 SENSITIVE: Keystore credentials — NEVER commit these
android/keystore.properties
android/*.keystore
android/*.jks

# 🔐 SENSITIVE: Firebase config (contains live API key)
# Keep this if your repo is PRIVATE. Add it here if your repo is PUBLIC.
# android/app/google-services.json

# ── iOS ───────────────────────────────────────────────────────────────────────
ios/Pods/
ios/build/
*.xcworkspace
DerivedData/

# ── Environment Variables ─────────────────────────────────────────────────────
# 🔐 SENSITIVE: Never commit .env files
.env
.env.local
.env.development
.env.production
.env.staging
.env*.local

# ── Editor & OS ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
*.swp
*.swo
.vscode/settings.json

# ── Logs & Temp ───────────────────────────────────────────────────────────────
logs/
*.log
.tmp/
tmp/
temp/

# ── Metro bundler ─────────────────────────────────────────────────────────────
.metro-health-check*

# ── Gradle wrapper (optional — keep gradlew but exclude caches) ───────────────
.gradle/

# ── Buck ──────────────────────────────────────────────────────────────────────
.buckd/
buck-out/
